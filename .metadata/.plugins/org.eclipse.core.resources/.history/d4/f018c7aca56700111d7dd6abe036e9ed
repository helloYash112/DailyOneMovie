	 // ✅ Fetch manifest and normalize lines
    public String getOriginalManifest(String manifestKey) {
        GetObjectRequest getReq = GetObjectRequest.builder()
                .bucket(bucketName)
                .key(manifestKey)
                .build();

        try (ResponseInputStream<GetObjectResponse> s3Object = s3Client.getObject(getReq);
             BufferedReader reader = new BufferedReader(new InputStreamReader(s3Object))) {

            return reader.lines()
                    .map(line -> line.replace("\r", "").trim()) // normalize CRLF + spaces
                    .collect(Collectors.joining("\n"));

        } catch (IOException e) {
            throw new RuntimeException("Error reading manifest", e);
        }
    }
    
    

    // ✅ Build presigned URL map for all .ts files
    
    public Map<String, String> getPresignedUrlsForSegments(String prefix) {
        Map<String, String> urls = new HashMap<>();
        String continuationToken = null;

        do {
            ListObjectsV2Request.Builder reqBuilder = ListObjectsV2Request.builder()
                    .bucket(bucketName)
                    .prefix(prefix);

            if (continuationToken != null) {
                reqBuilder.continuationToken(continuationToken);
            }

            ListObjectsV2Response response = s3Client.listObjectsV2(reqBuilder.build());

            for (S3Object obj : response.contents()) {
                if (!obj.key().endsWith(".ts")) continue;

                String fileName = obj.key()
                        .substring(obj.key().lastIndexOf("/") + 1)
                        .replace("\r", "")
                        .trim();

                PresignedGetObjectRequest signed = s3Presigner.presignGetObject(p ->
                        p.getObjectRequest(GetObjectRequest.builder()
                                .bucket(bucketName)
                                .key(obj.key())
                                .build())
                                .signatureDuration(Duration.ofHours(6)));

                urls.put(fileName, signed.url().toString());
            }

            continuationToken = response.nextContinuationToken();
        } while (continuationToken != null);

        return urls;
    }
   
    
    public String buildPresignedManifest(String manifestKey, String prefix) {
        String manifest = getOriginalManifest(manifestKey);
        Map<String, String> presignedUrls = getPresignedUrlsForSegments(prefix);

        StringBuilder rewritten = new StringBuilder();

        for (String line : manifest.split("\n")) {
            String normalized = line.replace("\r", "").trim();

            if (normalized.endsWith(".ts")) {
                String presignedUrl = presignedUrls.get(normalized);

                if (presignedUrl == null) {
                    throw new RuntimeException(
                        "Missing presigned URL for segment: " + normalized +
                        " | Available keys: " + presignedUrls.keySet()
                    );
                }

                rewritten.append(presignedUrl).append("\n");
            } else {
                rewritten.append(normalized).append("\n");
            }
        }

        return rewritten.toString();
    }
    

        /**
         * Transcodes a source file to HLS segments and pipes them concurrently to cloud storage.
         *
         * @param inputFile        The source video file.
         * @param movieId          Unique movie identifier used for S3 path prefixing.
         * @param progressCallback Callback updates reflecting upload progress percentages (0-100).
         * @return S3 URL/Key pattern pointing to the master playlist.
         * @throws Exception if processing or uploading fails.
         */
    public String uploadHlsFileToCloud(File inputFile, Long movieId, Consumer<Integer> progressCallback) throws Exception {
        Path tempDir = Files.createTempDirectory("hls_engine_");
        String outputDirStr = tempDir.toString();
        
        Set<String> uploadedFilesSet = ConcurrentHashMap.newKeySet();
        List<CompletableFuture<Void>> uploadTasks = new CopyOnWriteArrayList<>();
        
        // 1. Core Fix: Atomic counter tracks ACTUAL completed network transfers
        AtomicInteger completedUploadsCounter = new AtomicInteger(0);

        // 2. Predict target segment count based on source duration (for true linear calculation)
        int estimatedTotalSegments = estimateTotalSegments(inputFile, 4); // 4 seconds matches -hls_time below

        // Setup Reactive Filesystem Watcher Engine
        WatchService watchService = FileSystems.getDefault().newWatchService();
        tempDir.register(watchService, StandardWatchEventKinds.ENTRY_CREATE);

        // High-Performance Hardware-Agnostic FFmpeg HLS Configuration
        ProcessBuilder pb = new ProcessBuilder(
                "ffmpeg", "-y", "-i", inputFile.getAbsolutePath(),
                "-c:v", "libx264", "-preset", "ultrafast", 
                "-g", "48", "-sc_threshold", "0",
                "-c:a", "aac", "-b:a", "128k",
                "-hls_time", "4", 
                "-hls_list_size", "0",
                "-f", "hls", outputDirStr + "/playlist.m3u8"
        );

        pb.redirectErrorStream(true);
        Process process = pb.start();

        // Asynchronously handle log streaming to prevent OS buffer deadlocks
        CompletableFuture<Void> ffmpegLogTask = CompletableFuture.runAsync(() -> {
            try (BufferedReader reader = new BufferedReader(new InputStreamReader(process.getInputStream()))) {
                String line;
                while ((line = reader.readLine()) != null) {
                    // Suppressed line streaming or piping to log frameworks goes here
                	reader.lines().forEach(System.out::println);
                }
            } catch (IOException e) {
                System.err.println("Exception handled in log engine: " + e.getMessage());
            }
        });

        // Real-time Async Pipeline Worker Engine
        CompletableFuture<Void> pipelineUploaderTask = CompletableFuture.runAsync(() -> {
            try {
                while (process.isAlive()) {
                    WatchKey key = watchService.poll(100, TimeUnit.MILLISECONDS);
                    if (key != null) {
                        processWatchEvents(key, tempDir, movieId, uploadedFilesSet, uploadTasks, 
                                completedUploadsCounter, estimatedTotalSegments, progressCallback);
                    }
                }
                
                // Final Sweep: Empty the watcher queue of final segments written right at termination
                WatchKey finalKey;
                while ((finalKey = watchService.poll(50, TimeUnit.MILLISECONDS)) != null) {
                    processWatchEvents(finalKey, tempDir, movieId, uploadedFilesSet, uploadTasks, 
                            completedUploadsCounter, estimatedTotalSegments, progressCallback);
                }
            } catch (Exception e) {
                System.err.println("Critical Pipeline Exception: " + e.getMessage());
            }
        });

        // Lifecycle Determinism Strategy
        int ffmpegExitCode = process.waitFor();
        ffmpegLogTask.join();
        pipelineUploaderTask.join(); 
        watchService.close();

        if (ffmpegExitCode != 0) {
            throw new RuntimeException("FFmpeg runtime conversion crashed. Structural Exit Code: " + ffmpegExitCode);
        }

        // Guarantee All Background Chunk Uploads Finish Execution
        CompletableFuture.allOf(uploadTasks.toArray(new CompletableFuture[0])).join();

        // Atomic Upload of Final Manifest Playlist Index 
        File playlistFile = new File(outputDirStr + "/playlist.m3u8");
        String playlistKey = "hls/" + movieId + "/playlist.m3u8";
        
        if (playlistFile.exists()) {
            s3Client.putObject(PutObjectRequest.builder()
                            .bucket(bucketName)
                            .key(playlistKey)
                            .contentType("application/x-mpegURL")
                            .build(),
                    RequestBody.fromFile(playlistFile));
            playlistFile.delete();
        } else {
            throw new NoSuchFileException("The compilation process missing core asset file path: playlist.m3u8");
        }

        // 3. Force definitive 100% completion when everything is safely secured in cloud space
        progressCallback.accept(100);

        try {
            Files.deleteIfExists(tempDir);
        } catch (IOException e) {
            System.err.println("Soft failure clearing system directories: " + e.getMessage());
        }

        return playlistKey;
    }

    private void processWatchEvents(WatchKey key, Path tempDir, Long movieId, 
                                    Set<String> uploadedFilesSet, 
                                    List<CompletableFuture<Void>> uploadTasks, 
                                    AtomicInteger completedUploadsCounter,
                                    int estimatedTotalSegments,
                                    Consumer<Integer> progressCallback) {
        for (WatchEvent<?> event : key.pollEvents()) {
            Path fileName = (Path) event.context();
            File chunkFile = tempDir.resolve(fileName).toFile();
            String name = chunkFile.getName();

            if (name.endsWith(".ts") && uploadedFilesSet.add(name)) {
                CompletableFuture<Void> uploadTask = CompletableFuture.runAsync(() -> {
                    try {
                        long checkStart = System.currentTimeMillis();
                        while (chunkFile.length() == 0 && (System.currentTimeMillis() - checkStart) < 1000) {
                            Thread.sleep(20);
                        }

                        String s3Key = "hls/" + movieId + "/" + name;
                        
                        // Execute Cloud Transfer Request Block
                        s3Client.putObject(PutObjectRequest.builder()
                                        .bucket(bucketName)
                                        .key(s3Key)
                                        .contentType("video/MP2T")
                                        .build(),
                                RequestBody.fromFile(chunkFile));

                        chunkFile.delete();

                        // Increment tracking state ONLY following real upload success
                        int currentUploadedCount = completedUploadsCounter.incrementAndGet();

                        // Calculate progress accurately
                        int progress;
                        if (estimatedTotalSegments > 0) {
                            // Scale linearly between 0% and 98% based on actual file analysis
                            double ratio = (double) currentUploadedCount / estimatedTotalSegments;
                            progress = (int) Math.min(ratio * 98, 98);
                        } else {
                            // Adaptive Fallback: Smooth step asymptotic growth curve if file details are hidden
                            progress = (int) (95 * (1 - Math.exp(-0.07 * currentUploadedCount)));
                        }
                        
                        progressCallback.accept(Math.max(1, progress));

                    } catch (Exception ex) {
                        System.err.println("Execution fault on chunk payload: " + name + " -> " + ex.getMessage());
                    }
                }, uploadExecutor);

                uploadTasks.add(uploadTask);
            }
        }
        key.reset();
    }

    /**
     * Inspects input duration via ffprobe to compute highly reliable total chunk bounds.
     */
    private int estimateTotalSegments(File inputFile, int segmentDurationSeconds) {
        try {
            ProcessBuilder pb = new ProcessBuilder(
                "ffprobe", "-v", "error", "-show_entries", "format=duration",
                "-of", "default=noprint_wrappers=1:nocreepy=1:keyval=1", inputFile.getAbsolutePath()
            );
            Process p = pb.start();
            try (BufferedReader r = new BufferedReader(new InputStreamReader(p.getInputStream()))) {
                String line = r.readLine();
                if (line != null && line.startsWith("duration=")) {
                    double duration = Double.parseDouble(line.split("=")[1]);
                    return (int) Math.ceil(duration / segmentDurationSeconds);
                }
            }
        } catch (Exception e) {
            System.err.println("Tracking notice: ffprobe estimation context dropped. Falling back to dynamic curve algorithm.");
        }
        return -1; // Fallback signal flag
    }
    
}
